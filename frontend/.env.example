# Archivo de ejemplo para variables de entorno de desarrollo
# Copia este archivo como .env.development y reemplaza con tus valores reales

# ===================================================================
# 🔥 FIREBASE CONFIGURATION
# ===================================================================
# Obtener desde: Firebase Console → Project Settings → General → Your apps
VITE_API_KEY=AIzaSyB1234567890abcdefghijklmnop_REEMPLAZAR
VITE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_PROJECT_ID=tu-proyecto-id
VITE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_MESSAGING_SENDER_ID=123456789012
VITE_APP_ID=1:123456789012:web:abcdef1234567890_REEMPLAZAR

# ===================================================================
# 📱 PUSH NOTIFICATIONS (FCM)
# ===================================================================
# Obtener desde: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_VAPID_KEY=BNKou0yh41LB3USAmAY7IYTXCCBWZBC9fsWjOLgU4ouA9n0q9Kfei1vffKczvTJCqEpfAQMS1MFFcqgfIt_G1CE_REEMPLAZAR

# ===================================================================
# 🔧 CONFIGURACIÓN OPCIONAL
# ===================================================================
# URL de la API (generalmente no necesita cambios en desarrollo)
# VITE_API_URL=http://localhost:5001

# Modo debug (mostrar logs adicionales)
# VITE_DEBUG=true

# ===================================================================
# 📝 INSTRUCCIONES DE CONFIGURACIÓN
# ===================================================================
# 1. Copia este archivo como .env.development
# 2. Ve a Firebase Console: https://console.firebase.google.com
# 3. Selecciona tu proyecto AfterLife
# 4. Ve a Project Settings (ícono de engranaje)
# 5. En la sección "Your apps", selecciona tu web app
# 6. Copia los valores de firebaseConfig aquí
# 7. Ve a Cloud Messaging → Web Push certificates
# 8. Genera un par de claves y copia el VAPID key
# 9. Guarda el archivo y reinicia el servidor de desarrollo

# ===================================================================
# ⚠️  IMPORTANTE - SEGURIDAD
# ===================================================================
# - NO subir este archivo a git con valores reales
# - Cada desarrollador debe tener su propia copia
# - Para producción, usar .env.production con valores diferentes
# - Las variables deben empezar con VITE_ para ser accesibles en el frontend