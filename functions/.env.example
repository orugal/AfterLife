# ===================================================================
# 🔒 VARIABLES DE ENTORNO PARA FIREBASE FUNCTIONS
# ===================================================================
# Copia este archivo como .env y completa con tus credenciales reales

# Gmail SMTP para envío de emails de emergencia
GMAIL_USER=tu-email@gmail.com
GMAIL_APP_PASSWORD=tu-password-de-aplicacion-aqui

# Configuraciones del sistema
TIMEZONE=America/Bogota
DEFAULT_NOTIFICATION_DAYS=15
SENDER_NAME=AfterLife Monitor

# ===================================================================
# 📝 INSTRUCCIONES:
# ===================================================================
# 1. Copia este archivo: cp .env.example .env
# 2. Edita .env con tus credenciales reales
# 3. Para Gmail App Password:
#    - Ve a https://myaccount.google.com/security
#    - Activa 2FA si no lo tienes
#    - Genera "App Password" para "Mail"
#    - Usa esa password aquí (con espacios incluidos)
# ===================================================================